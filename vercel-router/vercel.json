{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/me", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/admin", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/login", "headers": [{ "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/web/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-cache, must-revalidate" }] }
  ],
  "rewrites": [
    { "source": "/", "destination": "/web/login.html" },
    { "source": "/v1/chat/completions", "destination": "/api/chat" },
    { "source": "/v1/models", "destination": "/api/models" },
    { "source": "/admin", "destination": "/web/me.html" },
    { "source": "/admin/", "destination": "/web/me.html" },
    { "source": "/login", "destination": "/web/login.html" },
    { "source": "/me", "destination": "/web/me.html" }
  ],
  "functions": {
    "api/chat.js": { "maxDuration": 120 },
    "api/admin.js": { "maxDuration": 30 }
  }
}
